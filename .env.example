# ============================================================
# KALYANAM SHOPPING MALL - Environment Variables
# PostgreSQL Database Configuration
# ============================================================

# Database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kalyanam_mall

# Example for managed PostgreSQL (e.g., Neon, Supabase, AWS RDS):
# DATABASE_URL=postgresql://user:password@host.region.db.provider.com:5432/dbname?sslmode=require

# Node environment
NODE_ENV=development

# Next.js configuration
PORT=3000