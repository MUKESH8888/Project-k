# Persistent directories (optional; defaults to .data/ under the app)
# COMMERCE_DATA_DIR=D:/Project K/kalyanam-data/commerce
# SESSION_DATA_DIR=D:/Project K/kalyanam-data/sessions
# Production origin, required behind a proxy with a different internal origin:
# APP_ORIGIN=https://your-store.example
# Enable only when a trusted proxy overwrites X-Forwarded-For:
# TRUST_PROXY=true
# The legacy DATABASE_URL in .env.local is preserved but not used by this backend.
# On Vercel, configure COMMERCE_DATABASE_URL and BLOB_READ_WRITE_TOKEN.
